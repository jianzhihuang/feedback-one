{
  "mcpServers": {
    "feedback-one": {
      "command": "uvx",
      "args": ["feedback-one@latest"],
      "timeout": 600000,
      "env": {
        "MCP_DESKTOP_MODE": "true",
        "MCP_WEB_HOST": "127.0.0.1",
        "MCP_WEB_PORT": "8765",
        "MCP_DEBUG": "false"
      },
      "autoApprove": ["interactive_feedback"]
    }
  }
}
